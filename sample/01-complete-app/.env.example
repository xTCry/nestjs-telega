BOT_TOKEN=
# Optional: a separate Bot API bot connected to a Telegram Business account.
BUSINESS_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to change business responses.
ADMIN_IDS=
PAID_MEDIA_FILE_ID=
# Optional. Get an ID with: /buttonemoji followed by one Telegram custom emoji.
# The bot owner must have Telegram Premium or additional usernames on Fragment.
BUTTON_CUSTOM_EMOJI_ID=
# Optional absolute path. By default: sample/01-complete-app/data/business-responses.json
BUSINESS_RESPONSES_FILE=
