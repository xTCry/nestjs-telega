{
  "name": "nestjs-telega",
  "version": "1.0.0-rc.1",
  "description": "Telegram bot module for NestJS",
  "keywords": [
    "nest",
    "nestjs",
    "nestjs-module",
    "telegraf",
    "telegraf-hardened",
    "telegram",
    "telegram bot",
    "telegram bot api",
    "bot",
    "bot api",
    "bot framework"
  ],
  "homepage": "https://github.com/xTCry/nestjs-telega#readme",
  "bugs": {
    "url": "https://github.com/xTCry/nestjs-telega/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xTCry/nestjs-telega.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "author": "xTCry [Vladislav Kh] (https://github.com/xTCry/)",
  "contributors": [
    {
      "name": "Aleksandr Bukhalo",
      "email": "evilsprut@icloud.com"
    },
    {
      "name": "Arthur Asimov",
      "email": "arthur.asimov.z0@gmail.com"
    }
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:sample": "tsc -p sample/01-complete-app/tsconfig.build.json",
    "start:sample": "npm --prefix sample/01-complete-app run start -- --no-shell",
    "start:sample:dev": "npm --prefix sample/01-complete-app run start:dev -- --no-shell",
    "format": "prettier --write \"lib/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"lib/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.js\"",
    "format:sample": "prettier --config .prettierrc --write \"sample/*/src/**/*.ts\"",
    "copy-to-sample": "node scripts/copy-to-sample.js",
    "postbuild": "npm run copy-to-sample",
    "lint": "eslint \"lib/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "precommit": "lint-staged",
    "prepublish:npm": "npm run build",
    "publish:npm": "npm publish --access public",
    "publish:npm:latest": "npm publish --access public --tag latest",
    "prerelease": "npm run build",
    "release": "release-it",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:patch": "release-it patch",
    "release:rc": "release-it --preRelease=rc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "typedoc:build": "typedoc --tsconfig ./tsconfig.typedoc.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -c .commitlintrc.json -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "20.2.0",
    "@commitlint/config-angular": "20.2.0",
    "@eslint/js": "^9.39.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/testing": "^11.1.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "conventional-commits-parser": "7.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "8.50.0",
    "@typescript-eslint/parser": "8.50.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "reflect-metadata": "0.2.2",
    "release-it": "^21.0.2",
    "telegraf-hardened": "^6.0.0",
    "ts-jest": "^29.4.6",
    "typedoc": "0.28.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.2.2",
    "telegraf-hardened": "^6.0.0",
    "typescript": "^4.1.2 || ^5.0.0"
  }
}
